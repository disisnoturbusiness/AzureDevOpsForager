# ---- Build output ----
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo

# ---- Local config (may contain SQL connection strings / tokens) ----
config.json
**/config.json

# ---- Secrets: the encrypted secrets store (Groq key, HF token, ...) never gets committed ----
secrets.enc
**/secrets.enc
groqapikey.enc
**/groqapikey.enc
groqapikey.txt
**/groqapikey.txt

# ---- Models: NOTHING model-related is committed. ----
# Users fetch their own ONNX exports with models/export-onnx.ps1. Only the scripts and docs
# in models/ are tracked; every downloaded artifact (weights, tokenizers, configs) stays local.
models/*
!models/*.ps1
!models/*.md
!models/.gitkeep

# ---- Runtime / generated ----
logs/
*.log
chunkerrors.txt
azdo_last_update.json
last_update.json
known_answers.json
chat_feedback.log

# ---- Throwaway / local-only ----
_e2e/
.shelf/

# VS source-control bindings (never commit)
*.vspscc
*.vssscc

# ---- Python build artifacts (docs/build_word_docs.py) ----
__pycache__/
*.pyc

# ---- Personal demo deploy (targets a specific Azure resource; not part of the give-away) ----
scripts/publish-demo.ps1

# ---- Local run logs ----
*.log
*.log.err
